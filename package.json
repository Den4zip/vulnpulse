{
  "name": "vulnpulse-desktop",
  "productName": "VulnPulse Desktop",
  "version": "0.1.0",
  "description": "SecOps / AppSec Vulnerability Hub — локальный агрегатор уязвимостей с матчингом по стеку компании",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "^1.0.0-rc.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "drizzle-kit": "^1.0.0-rc.5",
    "electron": "^45.0.0",
    "electron-vite": "^4.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  },
  "allowScripts": {
    "electron@45.0.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
